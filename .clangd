# clangd configuration for this ESP-IDF project.
# Uses the compile database generated by `idf.py build` (build/compile_commands.json).
# GCC-only Xtensa/optimisation flags (-m*, -f*) are dropped so clang can parse.
CompileFlags:
  CompilationDatabase: build
  Remove: [-m*, -f*]
  Add: [-Wdocumentation]

Diagnostics:
  UnusedIncludes: None
