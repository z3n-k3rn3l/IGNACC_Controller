# Doxygen configuration for IGNACC_Controller.
# Regenerate the HTML API docs (with the SVG diagrams) from the project root:
#     doxygen
# Output: docs/api/html/index.html (committed, so it can be browsed without Doxygen).
# Only the settings that differ from Doxygen's defaults are listed here.

PROJECT_NAME           = "IGNACC Controller"
PROJECT_NUMBER         = 1.2.0
PROJECT_BRIEF          = "ESP32 UART-controlled relay controller for ACC / IGN testing"
OUTPUT_DIRECTORY       = docs/api

# Sources: public headers, implementation, composition root and the docs.
INPUT                  = README.md docs components main tools/README.md
FILE_PATTERNS          = *.h *.c *.md
RECURSIVE              = YES
EXCLUDE                = docs/api
USE_MDFILE_AS_MAINPAGE = README.md
IMAGE_PATH             = docs/diagrams

# C project: show structs and functions, include static (file-local) helpers.
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES

# Output
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES

# Include / dependency graphs via Graphviz (winget install Graphviz.Graphviz).
# Set HAVE_DOT = NO if Graphviz isn't installed.
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

# Warnings
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = docs/api/doxygen-warnings.log
